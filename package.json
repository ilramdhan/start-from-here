{
  "name": "start-from-here",
  "version": "1.4.1",
  "description": "Agent Skill + zero-dependency installer: interviews you, then writes approved pre-code project docs (PRD, TRD, architecture, security, tests, legal, AGENTS.md) for any AI coding agent.",
  "type": "module",
  "bin": {
    "start-from-here": "bin/cli.mjs"
  },
  "files": [
    "skills",
    "bin",
    "lib",
    "dist",
    "adapters",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md",
    "docs/guides",
    ".claude-plugin",
    ".codex-plugin",
    "gemini-extension.json",
    "GEMINI-EXTENSION.md",
    "commands"
  ],
  "scripts": {
    "validate": "node scripts/validate-skill.mjs",
    "build": "node scripts/build-bundle.mjs",
    "test": "node scripts/run-tests.mjs",
    "check": "node bin/cli.mjs check",
    "prepublishOnly": "npm run validate && npm run build && npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "agent-skills",
    "skill",
    "skills",
    "claude-code",
    "codex",
    "gemini-cli",
    "github-copilot",
    "cursor",
    "ai",
    "prd",
    "architecture",
    "documentation",
    "project-planning",
    "vibe-coding",
    "agents-md"
  ],
  "author": "ilramdhan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ilramdhan/start-from-here.git"
  },
  "bugs": {
    "url": "https://github.com/ilramdhan/start-from-here/issues"
  },
  "homepage": "https://github.com/ilramdhan/start-from-here#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
